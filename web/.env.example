# Copie para .env.local e preencha. NUNCA faça commit de .env.local.
# Sem as variáveis de um serviço, o app usa a versão local (só em desenvolvimento).

# Endereço público do app (links dos e-mails, volta do login)
APP_URL=http://localhost:3000

# Segredos gerados por você: `openssl rand -base64 32`
SESSION_SECRET=
CRON_SECRET=

# Postgres. Local: postgres://postgres@localhost:5432/app
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
DATABASE_URL=
# Para as migrações no deploy: conexão DIRETA (Database > Connection string > "Direct connection", porta 5432)
MIGRATION_DATABASE_URL=

# Supabase Auth (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor; usado para apagar a conta do usuário
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (R2 > Manage API tokens; bucket PRIVADO)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend (domínio verificado com SPF/DKIM)
RESEND_API_KEY=
MAIL_FROM="Seu Estúdio <galerias@seudominio.com.br>"

# Asaas: chave do SANDBOX até o deploy. ASAAS_ENV=production só no /replica-deploy
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# O mesmo token que você coloca no painel do Asaas ao cadastrar o webhook
ASAAS_WEBHOOK_TOKEN=

# Páginas legais (/privacidade e /termos)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CNPJ=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Só para demonstração em produção sem os serviços (não use com clientes reais)
# DEMO_MODE=1
